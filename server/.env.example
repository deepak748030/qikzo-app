# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/tractorwaladealers

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Public base URL used to build absolute URLs for /uploads/*
# Leave blank to auto-derive from incoming request.
PUBLIC_BASE_URL=https://biding-app-plum.vercel.app
