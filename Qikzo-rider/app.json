{
  "expo": {
    "name": "Qikzo Partner",
    "slug": "quikzo-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quikzo-partner",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EDE5"
    },
    "android": {
      "package": "com.quikzo.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F0EDE5"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quikzo.partner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Qikzo Partner uses your location while you are online to match you with nearby jobs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Qikzo Partner uses your location during active trips for live tracking and navigation.",
        "NSCameraUsageDescription": "Qikzo Partner uses the camera to upload verification documents."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        { "android": { "compileSdkVersion": 35, "targetSdkVersion": 35, "minSdkVersion": 24 } }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Qikzo Partner uses your location while you are online to match you with nearby jobs." }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "apiUrl": "https://qikzo-app.onrender.com"
    }
  }
}
