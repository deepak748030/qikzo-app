{
    "name": "qikzo-server",
    "version": "1.0.0",
    "description": "Qikzo — on-demand delivery/ride booking backend (Express + MongoDB + Socket.io).",
    "main": "index.js",
    "private": true,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "seed": "tsx src/seed/seed.ts",
        "migrate": "tsx src/db/runMigrations.ts",
        "test:rewards": "node --test --import tsx src/__tests__/rewardMath.test.ts"
    },
    "dependencies": {
        "@sentry/node": "^10.65.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.6.0",
        "morgan": "^1.10.0",
        "multer": "^2.2.0",
        "pino": "^9.5.0",
        "pino-http": "^10.3.0",
        "socket.io": "^4.8.1",
        "uuid": "^10.0.0",
        "xss": "^1.0.15",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/hpp": "^0.2.5",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.14.10",
        "@types/uuid": "^10.0.0",
        "nodemon": "^3.1.4",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2"
    }
}
