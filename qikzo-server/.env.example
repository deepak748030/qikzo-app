# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/qikzo

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP — set to true in dev to always accept 123456 (no SMS sent)
OTP_DEV_MODE=true
OTP_FIXED_CODE=123456
OTP_TTL_SECONDS=300

# CORS (comma-separated list, or *)
CORS_ORIGIN=*

# Pricing (INR)
PRICE_BASE=25
PRICE_PER_KM=8
PRICE_MIN=40
